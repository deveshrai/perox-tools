import { VerticalBox } from "std-widgets.slint";

// A reusable part: drop it on any form from the designer's palette (This project).
export component Segmented inherits Rectangle {
    in property <[string]> items: ["Small", "Medium", "Large"];
    in-out property <int> current: 1;
    callback picked(index: int);
    background: #1a1210;
    border-radius: 12px;

    horizontal_layout1 := HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for item[i] in root.items : pill := Rectangle {
            background: i == root.current ? #d9a066 : pill_area.has-hover ? #ffffff10 : transparent;
            border-radius: 9px;
            horizontal-stretch: 1;
            min-height: 34px;
            min-width: 72px;
            animate background { duration: 180ms; easing: ease-out; }
            Text {
                color: i == root.current ? #1a1210 : #c9b09a;
                font-size: 13px;
                font-weight: 600;
                height: parent.height;
                horizontal-alignment: center;
                text: item;
                vertical-alignment: center;
                width: parent.width;
            }
            pill_area := TouchArea { mouse-cursor: pointer; clicked => { root.current = i; root.picked(i); } }
        }
    }
}
