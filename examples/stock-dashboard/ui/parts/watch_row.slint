import { VerticalBox } from "std-widgets.slint";

// A reusable part: drop it on any form from the designer's palette (This project).
export component WatchRow inherits Rectangle {
    in property <string> symbol: "AAPL";
    in property <string> company: "Apple Inc.";
    in property <string> price: "—";
    in property <string> change: "";
    in property <bool> up: true;
    in property <bool> selected: false;
    callback clicked();
    border-radius: 10px;
    height: 54px;
    background: root.selected ? #242b3b : row_area.has-hover ? #1b2029 : transparent;

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        names := VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                color: #e8ebf1;
                font-size: 14px;
                font-weight: 700;
                text: root.symbol;
            }
            Text {
                color: #8b95a7;
                font-size: 11px;
                overflow: elide;
                text: root.company;
            }
        }
        numbers := VerticalLayout {
            alignment: center;
            Text {
                color: #e8ebf1;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: right;
                text: root.price;
            }
            Text {
                color: root.up ? #3ecf8e : #f26d6d;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: right;
                text: root.change;
            }
        }
    }
    row_area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
