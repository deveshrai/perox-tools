import { VerticalBox } from "std-widgets.slint";

// A reusable part: drop it on any form from the designer's palette (This project).
export component Segmented inherits Rectangle {
    in property <[string]> items: ["1M", "3M", "6M", "1Y", "5Y"];
    in-out property <int> current: 0;
    callback picked(index: int);
    background: #12151c;
    border-radius: 10px;
    border-width: 1px;
    border-color: #ffffff10;

    horizontal_layout1 := HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for item[i] in root.items : pill := Rectangle {
            background: i == root.current ? #2f6fec : pill_area.has-hover ? #ffffff10 : transparent;
            border-radius: 7px;
            height: 28px;
            min-width: 46px;
            Text {
                color: i == root.current ? #ffffff : #aab3c2;
                font-size: 12px;
                font-weight: 600;
                height: parent.height;
                horizontal-alignment: center;
                text: item;
                vertical-alignment: center;
                width: parent.width;
            }
            pill_area := TouchArea { mouse-cursor: pointer; clicked => { root.current = i; root.picked(i); } }
        }
    }
}
